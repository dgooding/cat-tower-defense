{
  "name": "Catastrophe! The Great Snack Defense",
  "short_name": "Catastrophe!",
  "description": "A cozy, silly cat tower defense game. Seat your cats anywhere off the path and save the snacks.",
  "start_url": "./play.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#FBF5E9",
  "theme_color": "#F4A6B7",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
